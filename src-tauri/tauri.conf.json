{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/tauri-v1/tooling/cli/schema.json",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "devPath": "../src",
    "distDir": "../src",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "Ayaz DE",
    "version": "3.3.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "window": {
        "all": false,
        "startDragging": true,
        "close": true,
        "minimize": true,
        "maximize": true,
        "unmaximize": true,
        "show": true,
        "hide": true
      },
      "shell": {
        "all": false,
        "open": false
      }
    },
    "bundle": {
      "active": true,
      "category": "Utility",
      "copyright": "2026 Ankora Linux Project",
      "deb": {
        "depends": [
          "libwebkit2gtk-4.0-37 | libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1",
          "libnss3-tools",
          "plymouth",
          "openbox",
          "wmctrl",
          "xdotool"
        ]
      },
      "icon": [
        "icons/icon.png"
      ],
      "identifier": "org.ankora.ayaz",
      "targets": ["deb", "appimage"]
    },
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https: http://127.0.0.1:49152 http://127.0.0.1:11434 https://generativelanguage.googleapis.com https://api.groq.com https://api.openai.com https://openrouter.ai https://api.github.com; frame-src 'self' data: blob: https: http://127.0.0.1:49152; object-src 'self' data: blob:; base-uri 'self'; form-action 'self'"
    },
    "windows": [
      {
        "title": "Ayaz — Ankora Linux",
        "fullscreen": true,
        "decorations": false,
        "resizable": false,
        "transparent": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "center": true,
        "width": 1920,
        "height": 1080
      }
    ]
  }
}
