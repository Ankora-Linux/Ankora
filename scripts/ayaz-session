#!/bin/bash
# ==============================================================================
# Ankora Linux 4.0.1 — Ayaz DE Oturum Başlatıcı (ayaz-session)
# Openbox pencere yöneticisini, uyumluluk köprüsünü ve Ayaz arayüzünü başlatır.
# ==============================================================================
set -e

# Açılış ekranından X'e geçiş: Plymouth çalışıyorsa DRM/KMS kilidini bırakması için kapatılır
if command -v plymouth >/dev/null 2>&1 && plymouth --ping >/dev/null 2>&1; then
    plymouth quit 2>/dev/null || sudo plymouth quit 2>/dev/null || true
fi

# 1. X11 Temel Ayarları
if command -v xsetroot >/dev/null 2>&1; then
    xsetroot -solid "#13141b"
fi
if command -v xset >/dev/null 2>&1; then
    xset -dpms || true
    xset s off || true
    xset s noblank || true
fi

# WebKitGTK ve X11 ortam ayarları (fiziksel donanım ve sanal makine uyumluluğu)
export GDK_BACKEND=x11
export WEBKIT_DISABLE_DMABUF_RENDERER=1
export WEBKIT_DISABLE_SANDBOX_THIS_IS_DANGEROUS=1

# Düşük RAM optimizasyonları (800 MB -> 450 MB hedefi)
# Glibc thread arena kısıtlaması: WebKit thread patlamasını ve bellek şişmesini önler
export MALLOC_ARENA_MAX=2
# WebKitGTK önbellek modelini masaüstü/kiosk için hafif tutar
export WEBKIT_CACHE_MODEL=DOCUMENT_VIEWER
# Glib dilim ayırıcısının boşa çıkan belleği OS'a hemen iade etmesini sağlar
export G_SLICE=always-malloc

# Sanal makine (VirtualBox, QEMU, KVM, VMware) tespiti:
# Sanal GPU'larda DRI çökmelerini önlemek için yazılımsal render (llvmpipe) devreye alınır;
# Fiziksel donanımlarda tam GPU hızlandırması korunur.
IS_VM=0
for dmi in /sys/class/dmi/id/product_name /sys/class/dmi/id/sys_vendor /sys/class/dmi/id/board_vendor; do
    if [ -r "$dmi" ]; then
        case "$(cat "$dmi" 2>/dev/null)" in
            *[Vv]irtual[Bb]ox*|*[Vv][Mm]ware*|*KVM*|*QEMU*|*[Bb]ochs*|*innotek*) IS_VM=1; break ;;
        esac
    fi
done
if [ "$IS_VM" = "1" ]; then
    export LIBGL_ALWAYS_SOFTWARE=1
fi

# Eco RAM+ (ZRAM): 4 GB altı belleğe sahip cihazlarda (eski MEB / düşük RAM PC)
# açılışta ZRAM zstd/lz4 sıkıştırmalı takas alanını (RAM'in %50'si) otomatik devreye al
MEM_KB=$(grep -m1 MemTotal /proc/meminfo 2>/dev/null | awk '{print $2}')
if [ -n "$MEM_KB" ] && [ "$MEM_KB" -lt 4194304 ]; then
    if ! swapon -s 2>/dev/null | grep -q zram; then
        if [ -x /etc/init.d/zram-swap ]; then
            /etc/init.d/zram-swap start 2>/dev/null || true
        elif command -v modprobe >/dev/null 2>&1; then
            modprobe zram num_devices=1 2>/dev/null || true
            if [ -e /dev/zram0 ]; then
                for alg in zstd lz4 lzo; do
                    if grep -q "$alg" /sys/block/zram0/comp_algorithm 2>/dev/null; then
                        echo "$alg" > /sys/block/zram0/comp_algorithm 2>/dev/null && break
                    fi
                done
                DISKSIZE=$(( MEM_KB * 1024 / 2 ))
                echo "$DISKSIZE" > /sys/block/zram0/disksize 2>/dev/null || true
                mkswap /dev/zram0 >/dev/null 2>&1 || true
                swapon -p 100 /dev/zram0 2>/dev/null || true
            fi
        fi
    fi
fi

# Dokunmatik giriş (Faz tahta/IR çerçeve + dokunmatik ped): pedlerde
# dokun-kaydır, tahta aygıtları her zaman açık. Kalibrasyon Ayarlar'dan.
if [ -x /usr/bin/eta-touchdrv ]; then
    /usr/bin/eta-touchdrv --enable 2>/dev/null || true
fi
if command -v xinput >/dev/null 2>&1; then
    for _dev in $(xinput --list --id-only 2>/dev/null); do
        _name=$(xinput --list --name-only "$_dev" 2>/dev/null || true)
        case "$_name" in
            *[Tt]ouchpad*|*Synaptics*|*Elan*|*ELAN*)
                xinput --set-prop "$_dev" "libinput Tapping Enabled" 1 2>/dev/null || true
                xinput --set-prop "$_dev" "libinput Natural Scroll Enabled" 0 2>/dev/null || true
                xinput --set-prop "$_dev" "libinput Scroll Method Enabled" 0 0 1 2>/dev/null || true
                xinput --set-prop "$_dev" "libinput Click Method Enabled" 0 1 2>/dev/null || true
                ;;
            *[Tt]ouchscreen*|*[Tt]ouch*|*IR*|*Vestel*|*Arcelik*|*Faz*)
                xinput --enable "$_dev" 2>/dev/null || true
                ;;
        esac
    done
    unset _dev _name
fi

# 2. Openbox Yapılandırmasını Hazırla
OPENBOX_DIR="$HOME/.config/openbox"
mkdir -p "$OPENBOX_DIR"

if [ -f "/usr/share/ayaz/openbox-rc.xml" ]; then
    cp -u "/usr/share/ayaz/openbox-rc.xml" "$OPENBOX_DIR/rc.xml"
elif [ -f "/etc/xdg/openbox/rc.xml" ] && [ ! -f "$OPENBOX_DIR/rc.xml" ]; then
    cp "/etc/xdg/openbox/rc.xml" "$OPENBOX_DIR/rc.xml"
fi

# 3. Pencere Yöneticisi (Openbox) Başlat
if command -v openbox >/dev/null 2>&1; then
    if [ -f "$OPENBOX_DIR/rc.xml" ]; then
        openbox --config-file "$OPENBOX_DIR/rc.xml" &
    else
        openbox &
    fi
    OPENBOX_PID=$!
fi

# 4. Ses ve Polkit Ajanı
if command -v pulseaudio >/dev/null 2>&1; then
    pulseaudio --start --exit-idle-time=30 2>/dev/null || true
fi

if command -v lxpolkit >/dev/null 2>&1; then
    lxpolkit &
elif [ -x /usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1 ]; then
    /usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1 &
fi

# 5. XSettings Daemon (GTK/Qt Tema Eşitleme)
if command -v xsettingsd >/dev/null 2>&1; then
    xsettingsd &
fi

# 6. Ayaz DE Başlatma ve Temiz Kapanış
cleanup() {
    if [ -n "${OPENBOX_PID:-}" ]; then
        kill "$OPENBOX_PID" 2>/dev/null || true
    fi
    pkill -P $$ 2>/dev/null || true
}
trap cleanup EXIT INT TERM

if [ -x /usr/bin/ayaz ]; then
    /usr/bin/ayaz
elif [ -x /usr/local/bin/ayaz ]; then
    /usr/local/bin/ayaz
elif [ -x "$(dirname "$0")/../src-tauri/target/release/ayaz-de" ]; then
    "$(dirname "$0")/../src-tauri/target/release/ayaz-de"
else
    xterm -e "echo [HATA] Ayaz ikili dosyası bulunamadı!; sh" || true
fi
