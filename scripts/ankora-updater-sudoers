# /etc/sudoers.d/ankora-updater
# Ankora Ayaz DE — Sıkılaştırılmış Yetki Politikası (P1 #6)
# GÜVENLIK:
#   - Yerel .deb / paket kurma-kaldırma (install *, remove *, vendor *) ve
#     disk yazma/biçimlendirme (usb-flash *, usb-format *), anlık görüntü geri
#     yükleme/silme NOPASSWD listesinden kaldırılmıştır (pkexec parola onayı ister).
#   - Güncelleyici yalnızca resmî Ankora-Linux deposundan --fetch-and-install
#     modunda root tarafından indirip doğruladığı paketi kurabilir (--stage yok).
ankora ALL=(root) NOPASSWD: /usr/local/bin/ayaz-update-helper --fetch-and-install https\://github.com/Ankora-Linux/*, /usr/local/bin/ayaz-update-helper --check-and-apply, /usr/local/bin/ayaz-pkg-helper apt-update, /usr/local/bin/ayaz-pkg-helper apt-upgrade, /usr/local/bin/ayaz-pkg-helper mebcert, /usr/local/bin/ayaz-pkg-helper mebcert-remove, /usr/local/bin/ayaz-pkg-helper set-timezone *, /usr/local/bin/ayaz-pkg-helper set-keyboard *, /usr/local/bin/ayaz-pkg-helper set-language *, /usr/local/bin/ayaz-pkg-helper sync-ntp, /usr/local/bin/ayaz-pkg-helper drop-caches, /usr/local/bin/ayaz-pkg-helper suspend, /usr/local/bin/ankora-doctor, /usr/local/bin/ankora-ollama-install, /sbin/poweroff, /usr/sbin/poweroff, /sbin/reboot, /usr/sbin/reboot, /sbin/shutdown, /usr/sbin/shutdown
%sudo ALL=(root) NOPASSWD: /usr/local/bin/ayaz-update-helper --fetch-and-install https\://github.com/Ankora-Linux/*, /usr/local/bin/ayaz-update-helper --check-and-apply, /usr/local/bin/ayaz-pkg-helper apt-update, /usr/local/bin/ayaz-pkg-helper apt-upgrade, /usr/local/bin/ayaz-pkg-helper mebcert, /usr/local/bin/ayaz-pkg-helper mebcert-remove, /usr/local/bin/ayaz-pkg-helper set-timezone *, /usr/local/bin/ayaz-pkg-helper set-keyboard *, /usr/local/bin/ayaz-pkg-helper set-language *, /usr/local/bin/ayaz-pkg-helper sync-ntp, /usr/local/bin/ayaz-pkg-helper drop-caches, /usr/local/bin/ayaz-pkg-helper suspend, /usr/local/bin/ankora-doctor, /usr/local/bin/ankora-ollama-install, /sbin/poweroff, /usr/sbin/poweroff, /sbin/reboot, /usr/sbin/reboot, /sbin/shutdown, /usr/sbin/shutdown
