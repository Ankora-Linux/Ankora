# /etc/sudoers.d/ankora-updater
# Ankora Ayaz DE update helper permissions
# GÜVENLIK: Yalnızca belirli güncelleme yardımcılarına sınırlı NOPASSWD erişimi
# /tmp yerine güvenli staging dizini kullanılır (/var/cache/ayaz-updates/)
# Güç komutları usr-merge yolunun iki varyantıyla verilir (Devuan Daedalus'ta
# /sbin, /usr/sbin'a sembolik bağdır; kurulu sistemlerde ikisi de uygulanır).
# Not: install-deb-file yetkisiz NOPASSWD listesinden bilerek hariç tutulur;
# yerel .deb kurulumu kurulu sistemlerde pkexec (parola onayı) gerektirir.
ankora ALL=(root) NOPASSWD: /usr/local/bin/ayaz-update-helper, /usr/local/bin/ayaz-pkg-helper apt-update, /usr/local/bin/ayaz-pkg-helper apt-upgrade, /usr/local/bin/ayaz-pkg-helper install *, /usr/local/bin/ayaz-pkg-helper remove *, /usr/local/bin/ayaz-pkg-helper vendor *, /usr/local/bin/ayaz-pkg-helper mebcert, /usr/local/bin/ayaz-pkg-helper mebcert-remove, /usr/local/bin/ayaz-pkg-helper snapshot-create*, /usr/local/bin/ayaz-pkg-helper snapshot-restore *, /usr/local/bin/ayaz-pkg-helper snapshot-delete *, /usr/local/bin/ayaz-pkg-helper set-timezone *, /usr/local/bin/ayaz-pkg-helper set-keyboard *, /usr/local/bin/ayaz-pkg-helper set-language *, /usr/local/bin/ayaz-pkg-helper sync-ntp, /usr/local/bin/ayaz-pkg-helper drop-caches, /usr/local/bin/ayaz-pkg-helper usb-flash *, /usr/local/bin/ayaz-pkg-helper usb-format *, /usr/local/bin/ankora-doctor, /usr/local/bin/ankora-ollama-install, /bin/true, /usr/bin/true, /sbin/poweroff, /usr/sbin/poweroff, /sbin/reboot, /usr/sbin/reboot, /sbin/shutdown, /usr/sbin/shutdown
%sudo ALL=(root) NOPASSWD: /usr/local/bin/ayaz-update-helper, /usr/local/bin/ayaz-pkg-helper apt-update, /usr/local/bin/ayaz-pkg-helper apt-upgrade, /usr/local/bin/ayaz-pkg-helper install *, /usr/local/bin/ayaz-pkg-helper remove *, /usr/local/bin/ayaz-pkg-helper vendor *, /usr/local/bin/ayaz-pkg-helper mebcert, /usr/local/bin/ayaz-pkg-helper mebcert-remove, /usr/local/bin/ayaz-pkg-helper snapshot-create*, /usr/local/bin/ayaz-pkg-helper snapshot-restore *, /usr/local/bin/ayaz-pkg-helper snapshot-delete *, /usr/local/bin/ayaz-pkg-helper set-timezone *, /usr/local/bin/ayaz-pkg-helper set-keyboard *, /usr/local/bin/ayaz-pkg-helper set-language *, /usr/local/bin/ayaz-pkg-helper sync-ntp, /usr/local/bin/ayaz-pkg-helper drop-caches, /usr/local/bin/ayaz-pkg-helper usb-flash *, /usr/local/bin/ayaz-pkg-helper usb-format *, /usr/local/bin/ankora-doctor, /usr/local/bin/ankora-ollama-install, /bin/true, /usr/bin/true, /sbin/poweroff, /usr/sbin/poweroff, /sbin/reboot, /usr/sbin/reboot, /sbin/shutdown, /usr/sbin/shutdown
