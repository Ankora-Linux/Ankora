<?xml version="1.0" encoding="UTF-8"?>
<!-- ====================================================================== -->
<!-- Ankora Linux 2.0 (Ayaz DE) — Openbox X11 Uyumluluk Yapılandırması      -->
<!-- Görev çubuğunu pencerelerden korur, pencere bölme (snap) ve             -->
<!-- Super (Windows) tuşu köprüsünü sağlar.                                 -->
<!-- ====================================================================== -->
<openbox_config xmlns="http://openbox.org/3.4/rc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://openbox.org/3.4/rc file:///usr/share/openbox/rc.xsd">

  <resistance>
    <strength>10</strength>
    <screen_edge_strength>20</screen_edge_strength>
  </resistance>

  <focus>
    <focusNew>yes</focusNew>
    <followMouse>no</followMouse>
    <focusLast>yes</focusLast>
    <underMouse>no</underMouse>
    <focusDelay>200</focusDelay>
    <raiseOnFocus>no</raiseOnFocus>
  </focus>

  <placement>
    <policy>Smart</policy>
    <center>yes</center>
    <monitor>Primary</monitor>
    <primaryMonitor>1</primaryMonitor>
  </placement>

  <theme>
    <name>Clearlooks</name>
    <titleLayout>NLIMC</titleLayout>
    <keepBorder>yes</keepBorder>
    <animateIconify>no</animateIconify>
    <font place="ActiveWindow">
      <name>Sans</name>
      <size>9</size>
      <weight>Bold</weight>
      <slant>Normal</slant>
    </font>
    <font place="InactiveWindow">
      <name>Sans</name>
      <size>9</size>
      <weight>Normal</weight>
      <slant>Normal</slant>
    </font>
    <font place="MenuHeader">
      <name>Sans</name>
      <size>9</size>
      <weight>Bold</weight>
      <slant>Normal</slant>
    </font>
    <font place="MenuItem">
      <name>Sans</name>
      <size>9</size>
      <weight>Normal</weight>
      <slant>Normal</slant>
    </font>
    <font place="ActiveOnScreenDisplay">
      <name>Sans</name>
      <size>9</size>
      <weight>Bold</weight>
      <slant>Normal</slant>
    </font>
    <font place="InactiveOnScreenDisplay">
      <name>Sans</name>
      <size>9</size>
      <weight>Normal</weight>
      <slant>Normal</slant>
    </font>
  </theme>

  <desktops>
    <number>4</number>
    <firstdesk>1</firstdesk>
    <names>
      <name>Ana</name>
      <name>İş</name>
      <name>Web</name>
      <name>Medya</name>
    </names>
    <popupTime>600</popupTime>
  </desktops>

  <resize>
    <drawContent>yes</drawContent>
    <popupShow>Nonpixel</popupShow>
    <popupPosition>Center</popupPosition>
    <popupFixedPosition>
      <x>10</x>
      <y>10</y>
    </popupFixedPosition>
  </resize>

  <!-- ====================================================================== -->
  <!-- KRİTİK GÖREV ÇUBUĞU KORUMASI:                                           -->
  <!-- Ekranın altındaki 56px rezerve edilir. Hiçbir pencere maximize          -->
  <!-- edildiğinde veya taşındığında Ayaz görev çubuğunun üzerine binemez!    -->
  <!-- ====================================================================== -->
  <margins>
    <top>0</top>
    <bottom>56</bottom>
    <left>0</left>
    <right>0</right>
  </margins>

  <dock>
    <position>Bottom</position>
    <floatingX>0</floatingX>
    <floatingY>0</floatingY>
    <noStrut>no</noStrut>
    <stacking>Above</stacking>
    <direction>Horizontal</direction>
    <autoHide>no</autoHide>
    <hideDelay>300</hideDelay>
    <showDelay>300</showDelay>
    <moveButton>Middle</moveButton>
  </dock>

  <keyboard>
    <chainQuitKey>C-g</chainQuitKey>

    <!-- Super (Windows) tuşu köprüsü: Ayaz Başlat Menüsünü Aç / Kapat -->
    <keybind key="Super_L">
      <action name="Execute">
        <command>/usr/bin/ayaz-ctl toggle-start</command>
      </action>
    </keybind>
    <keybind key="W-space">
      <action name="Execute">
        <command>/usr/bin/ayaz-ctl toggle-start</command>
      </action>
    </keybind>

    <!-- Alt+Space: Evrensel Hızlı Arama (Spotlight / KRunner) -->
    <keybind key="A-space">
      <action name="Execute">
        <command>/usr/bin/ayaz-ctl toggle-spotlight</command>
      </action>
    </keybind>

    <!-- Alt+Tab: Standart ve akıcı pencere geçişi -->
    <keybind key="A-Tab">
      <action name="NextWindow">
        <finalactions>
          <action name="Focus"/>
          <action name="Raise"/>
          <action name="Unshade"/>
        </finalactions>
      </action>
    </keybind>
    <keybind key="A-S-Tab">
      <action name="PreviousWindow">
        <finalactions>
          <action name="Focus"/>
          <action name="Raise"/>
          <action name="Unshade"/>
        </finalactions>
      </action>
    </keybind>

    <!-- Alt+F4: Aktif pencereyi kapat -->
    <keybind key="A-F4">
      <action name="Close"/>
    </keybind>

    <!-- Super+D: Masaüstünü göster (Tüm pencereleri küçült) -->
    <keybind key="W-d">
      <action name="ToggleShowDesktop"/>
    </keybind>

    <!-- Super+L: Ekranı Kilitle -->
    <keybind key="W-l">
      <action name="Execute">
        <command>/usr/bin/ayaz-ctl lock</command>
      </action>
    </keybind>

    <!-- ====================================================================== -->
    <!-- AERO SNAP / PENCERE DÖŞEME (TILING) KISAYOLLARI:                       -->
    <!-- Windows ve modern DE tarzı yarı yarıya ekran bölme                     -->
    <!-- ====================================================================== -->
    <!-- Super + Sol Ok: Ekranın sol yarısına yasla (%50 genişlik) -->
    <keybind key="W-Left">
      <action name="Unmaximize"/>
      <action name="MoveResizeTo">
        <x>0</x>
        <y>0</y>
        <width>50%</width>
        <height>100%</height>
      </action>
    </keybind>

    <!-- Super + Sağ Ok: Ekranın sağ yarısına yasla (%50 genişlik) -->
    <keybind key="W-Right">
      <action name="Unmaximize"/>
      <action name="MoveResizeTo">
        <x>50%</x>
        <y>0</y>
        <width>50%</width>
        <height>100%</height>
      </action>
    </keybind>

    <!-- Super + Yukarı Ok: Maksimize Et (Alttaki 56px görev çubuğu hariç) -->
    <keybind key="W-Up">
      <action name="Maximize"/>
    </keybind>

    <!-- Super + Aşağı Ok: Küçült (Minimize / Restore) -->
    <keybind key="W-Down">
      <action name="Unmaximize"/>
    </keybind>

    <!-- Ctrl+Alt+T: Terminal -->
    <keybind key="C-A-t">
      <action name="Execute">
        <command>x-terminal-emulator</command>
      </action>
    </keybind>

    <!-- PrintScreen: Ekran Görüntüsü -->
    <keybind key="Print">
      <action name="Execute">
        <command>/usr/bin/ayaz-ctl screenshot</command>
      </action>
    </keybind>
  </keyboard>

  <mouse>
    <dragThreshold>1</dragThreshold>
    <doubleClickTime>500</doubleClickTime>
    <screenEdgeWarpTime>400</screenEdgeWarpTime>
    <screenEdgeWarpMouse>false</screenEdgeWarpMouse>

    <context name="Frame">
      <mousebind button="A-Left" action="Press">
        <action name="Focus"/>
        <action name="Raise"/>
      </mousebind>
      <mousebind button="A-Left" action="Click">
        <action name="Unshade"/>
      </mousebind>
      <mousebind button="A-Left" action="Drag">
        <action name="Move"/>
      </mousebind>
      <mousebind button="A-Right" action="Press">
        <action name="Focus"/>
        <action name="Raise"/>
        <action name="Unshade"/>
      </mousebind>
      <mousebind button="A-Right" action="Drag">
        <action name="Resize"/>
      </mousebind>
    </context>

    <context name="Titlebar">
      <mousebind button="Left" action="Drag">
        <action name="Move"/>
      </mousebind>
      <mousebind button="Left" action="DoubleClick">
        <action name="ToggleMaximize"/>
      </mousebind>
    </context>

    <context name="Close">
      <mousebind button="Left" action="Press">
        <action name="Focus"/>
        <action name="Raise"/>
        <action name="Unshade"/>
      </mousebind>
      <mousebind button="Left" action="Click">
        <action name="Close"/>
      </mousebind>
    </context>

    <context name="Maximize">
      <mousebind button="Left" action="Press">
        <action name="Focus"/>
        <action name="Raise"/>
        <action name="Unshade"/>
      </mousebind>
      <mousebind button="Left" action="Click">
        <action name="ToggleMaximize"/>
      </mousebind>
    </context>

    <context name="Iconify">
      <mousebind button="Left" action="Press">
        <action name="Focus"/>
        <action name="Raise"/>
        <action name="Unshade"/>
      </mousebind>
      <mousebind button="Left" action="Click">
        <action name="Iconify"/>
      </mousebind>
    </context>
  </mouse>

  <!-- ====================================================================== -->
  <!-- UYGULAMA KURALLARI:                                                    -->
  <!-- Ayaz DE Kiosk Penceresi İçin Özel Ayarlar                              -->
  <!-- ====================================================================== -->
  <applications>
    <!-- Ayaz Masaüstü Kabuğu: Çerçevesiz, masaüstü katmanında, görev çubuğunda görünmez -->
    <application class="*ayaz*" name="*ayaz*" title="*Ayaz*">
      <decor>no</decor>
      <position force="yes">
        <x>0</x>
        <y>0</y>
      </position>
      <focus>yes</focus>
      <layer>below</layer>
      <desktop>all</desktop>
      <skip_taskbar>yes</skip_taskbar>
      <skip_pager>yes</skip_pager>
    </application>

    <!-- Diyalog ve onay pencereleri her zaman ortalanır ve odaklanır -->
    <application type="dialog">
      <decor>yes</decor>
      <focus>yes</focus>
      <layer>normal</layer>
    </application>

    <application class="*lxpolkit*" name="*lxpolkit*">
      <decor>yes</decor>
      <focus>yes</focus>
      <layer>above</layer>
    </application>
  </applications>

</openbox_config>
